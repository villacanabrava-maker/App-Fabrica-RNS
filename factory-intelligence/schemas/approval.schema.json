{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rns.local/schemas/approval.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "subject_type", "subject_id", "gate", "target_sha", "decision", "requested_by", "requested_at"],
  "properties": {
    "approval_id": {"type": "string"},
    "subject_type": {"enum": ["spec", "task", "review", "pull_request", "deployment", "release", "policy_exception"]},
    "subject_id": {"type": "string"},
    "gate": {"type": "string"},
    "target_sha": {"type": ["string", "null"]},
    "decision": {"enum": ["pending", "approved", "rejected", "expired", "revoked"]},
    "requested_by": {"type": "string"},
    "requested_at": {"type": "string", "format": "date-time"},
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"], "format": "date-time"},
    "reason": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  }
}

