{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rns.local/schemas/event-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "organization_id", "correlation_id", "producer", "subject", "data"],
  "properties": {
    "event_id": {"type": "string"},
    "event_type": {"type": "string", "pattern": "^[a-z]+(\\.[a-z_]+)+\\.v[0-9]+$"},
    "schema_version": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "organization_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "causation_id": {"type": ["string", "null"]},
    "producer": {"type": "string"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {"type": {"type": "string"}, "id": {"type": "string"}}
    },
    "data": {"type": "object"}
  }
}

