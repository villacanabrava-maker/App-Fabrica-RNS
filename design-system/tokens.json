{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens da Fábrica Apps RNS. Três níveis: primitivo -> semântico -> componente. Nenhum componente referencia o nível primitivo diretamente.",

  "primitive": {
    "$description": "Nível 1. Valores brutos, sem significado.",
    "color": {
      "violet": {
        "500": { "$type": "color", "$value": "#7C3AED" },
        "600": { "$type": "color", "$value": "#6D28D9" },
        "700": { "$type": "color", "$value": "#5B21B6" },
        "100": { "$type": "color", "$value": "#EDE9FE" }
      },
      "indigo": {
        "600": { "$type": "color", "$value": "#4F46E5" }
      },
      "ink":    { "$type": "color", "$value": "#0F0A1F" },
      "neutral": {
        "0":   { "$type": "color", "$value": "#FFFFFF" },
        "50":  { "$type": "color", "$value": "#FAFAFB" },
        "100": { "$type": "color", "$value": "#F4F4F6" },
        "200": { "$type": "color", "$value": "#E7E7EC" },
        "300": { "$type": "color", "$value": "#D3D3DC" },
        "400": { "$type": "color", "$value": "#A0A0AE" },
        "500": { "$type": "color", "$value": "#71717F" },
        "600": { "$type": "color", "$value": "#52525E" },
        "700": { "$type": "color", "$value": "#3F3F49" },
        "800": { "$type": "color", "$value": "#27272E" },
        "900": { "$type": "color", "$value": "#18181D" },
        "950": { "$type": "color", "$value": "#0C0C10" }
      },
      "green":  { "600": { "$type": "color", "$value": "#16A34A" } },
      "amber":  { "500": { "$type": "color", "$value": "#F59E0B" } },
      "red":    { "600": { "$type": "color", "$value": "#DC2626" },
                  "800": { "$type": "color", "$value": "#991B1B" } },
      "blue":   { "600": { "$type": "color", "$value": "#2563EB" } }
    },
    "space": {
      "0":  { "$type": "dimension", "$value": "0px" },
      "1":  { "$type": "dimension", "$value": "4px" },
      "2":  { "$type": "dimension", "$value": "8px" },
      "3":  { "$type": "dimension", "$value": "12px" },
      "4":  { "$type": "dimension", "$value": "16px" },
      "5":  { "$type": "dimension", "$value": "20px" },
      "6":  { "$type": "dimension", "$value": "24px" },
      "8":  { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "20": { "$type": "dimension", "$value": "80px" }
    },
    "radius": {
      "sm":   { "$type": "dimension", "$value": "6px" },
      "md":   { "$type": "dimension", "$value": "10px" },
      "lg":   { "$type": "dimension", "$value": "14px" },
      "xl":   { "$type": "dimension", "$value": "20px" },
      "full": { "$type": "dimension", "$value": "9999px" }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast":    { "$type": "duration", "$value": "150ms" },
      "normal":  { "$type": "duration", "$value": "220ms" },
      "slow":    { "$type": "duration", "$value": "320ms" }
    }
  },

  "brand": {
    "$description": "Identidade RNS. NÃO é a identidade padrão de nenhuma biblioteca.",
    "primary":        { "$type": "color", "$value": "{primitive.color.violet.600}" },
    "primary-hover":  { "$type": "color", "$value": "{primitive.color.violet.700}" },
    "primary-subtle": { "$type": "color", "$value": "{primitive.color.violet.100}" },
    "accent":         { "$type": "color", "$value": "{primitive.color.indigo.600}" },
    "ink":            { "$type": "color", "$value": "{primitive.color.ink}" },
    "gradient":       { "$type": "gradient",
                        "$value": "linear-gradient(135deg, #4F46E5 0%, #6D28D9 100%)" }
  },

  "semantic": {
    "$description": "Nível 2. Significado, independente de tela. Cada token tem valor para tema claro e escuro.",
    "bg": {
      "app":              { "light": "{primitive.color.neutral.50}",  "dark": "{primitive.color.neutral.950}" },
      "surface":          { "light": "{primitive.color.neutral.0}",   "dark": "{primitive.color.neutral.900}" },
      "surface-elevated": { "light": "{primitive.color.neutral.0}",   "dark": "{primitive.color.neutral.800}" },
      "sidebar":          { "light": "{brand.ink}",                   "dark": "{brand.ink}" }
    },
    "border": {
      "default": { "light": "{primitive.color.neutral.200}", "dark": "{primitive.color.neutral.800}" },
      "strong":  { "light": "{primitive.color.neutral.300}", "dark": "{primitive.color.neutral.700}" }
    },
    "text": {
      "primary":   { "light": "{primitive.color.neutral.900}", "dark": "{primitive.color.neutral.50}" },
      "secondary": { "light": "{primitive.color.neutral.700}", "dark": "{primitive.color.neutral.300}" },
      "muted":     { "light": "{primitive.color.neutral.500}", "dark": "{primitive.color.neutral.400}" },
      "on-brand":  { "light": "{primitive.color.neutral.0}",   "dark": "{primitive.color.neutral.0}" }
    },
    "action": {
      "primary": { "light": "{brand.primary}", "dark": "{brand.primary}" }
    },
    "focus": {
      "ring": { "light": "{brand.accent}", "dark": "{brand.accent}" }
    },
    "status": {
      "$description": "★ Cor NUNCA é o único portador de significado. Todo estado tem ícone e rótulo textual além da cor.",
      "success":  { "$type": "color", "$value": "{primitive.color.green.600}" },
      "warning":  { "$type": "color", "$value": "{primitive.color.amber.500}" },
      "danger":   { "$type": "color", "$value": "{primitive.color.red.600}" },
      "info":     { "$type": "color", "$value": "{primitive.color.blue.600}" },
      "neutral":  { "$type": "color", "$value": "{primitive.color.neutral.500}" },
      "critical": { "$type": "color", "$value": "{primitive.color.red.800}" }
    }
  },

  "component": {
    "$description": "Nível 3. Uso específico. Referencia APENAS o nível semântico.",
    "button": {
      "primary": {
        "background":       { "$value": "{semantic.action.primary}" },
        "background-hover": { "$value": "{brand.primary-hover}" },
        "text":             { "$value": "{semantic.text.on-brand}" }
      },
      "size": {
        "sm": { "$type": "dimension", "$value": "32px" },
        "md": { "$type": "dimension", "$value": "40px" },
        "lg": { "$type": "dimension", "$value": "48px" }
      }
    },
    "run": {
      "status": {
        "running":        { "$value": "{semantic.status.info}" },
        "succeeded":      { "$value": "{semantic.status.success}" },
        "failed":         { "$value": "{semantic.status.danger}" },
        "awaiting-human": { "$value": "{semantic.status.warning}" },
        "blocked":        { "$value": "{semantic.status.critical}" },
        "cancelled":      { "$value": "{semantic.status.neutral}" }
      }
    },
    "review": {
      "finding": {
        "info":     { "$value": "{semantic.status.neutral}" },
        "low":      { "$value": "{semantic.status.neutral}" },
        "medium":   { "$value": "{semantic.status.warning}" },
        "high":     { "$value": "{semantic.status.danger}" },
        "critical": { "$value": "{semantic.status.critical}" }
      }
    },
    "layout": {
      "sidebar-expanded": { "$type": "dimension", "$value": "260px" },
      "sidebar-compact":  { "$type": "dimension", "$value": "72px" },
      "topbar-height":    { "$type": "dimension", "$value": "64px" },
      "content-max":      { "$type": "dimension", "$value": "1440px" },
      "side-panel":       { "$type": "dimension", "$value": "340px" }
    }
  },

  "typography": {
    "$description": "Famílias em UNSPECIFIED: escolher na Fase 1 e registrar aqui.",
    "family": {
      "sans": { "$type": "fontFamily", "$value": "UNSPECIFIED" },
      "mono": { "$type": "fontFamily", "$value": "UNSPECIFIED" }
    },
    "scale": {
      "display":  { "size": "40px", "lineHeight": "48px", "weight": 700 },
      "h1":       { "size": "32px", "lineHeight": "40px", "weight": 700 },
      "h2":       { "size": "24px", "lineHeight": "32px", "weight": 600 },
      "h3":       { "size": "20px", "lineHeight": "28px", "weight": 600 },
      "body-lg":  { "size": "16px", "lineHeight": "24px", "weight": 400 },
      "body":     { "size": "14px", "lineHeight": "20px", "weight": 400 },
      "body-sm":  { "size": "13px", "lineHeight": "18px", "weight": 400 },
      "caption":  { "size": "12px", "lineHeight": "16px", "weight": 400 },
      "label":    { "size": "12px", "lineHeight": "16px", "weight": 600 },
      "metric":   { "size": "32px", "lineHeight": "36px", "weight": 700 },
      "mono":     { "size": "13px", "lineHeight": "20px", "weight": 400 }
    }
  },

  "breakpoints": {
    "sm":  "640px",
    "md":  "768px",
    "lg":  "1024px",
    "xl":  "1280px",
    "2xl": "1536px"
  }
}
