# Fábrica Apps RNS — variáveis de ambiente (exemplo)
#
# Copie para .env.local (nunca commitado — ver .gitignore) e preencha com
# valores reais do seu projeto Supabase local ou de preview.
#
# Convenção de nomes de chave: docs/05-SEGURANCA/01-MODELO-DE-SEGURANCA.md
#   sb_publishable_...  pode ir ao navegador (prefixo NEXT_PUBLIC_ aqui)
#   sb_secret_...       NUNCA vai ao navegador — sem prefixo NEXT_PUBLIC_
#
# Mais variáveis (GitHub App, OpenAI, Anthropic, Vercel) entram conforme os
# sprints que as usam (1.9, 2.x) as introduzem — ver
# docs/08-PLANO-DE-IMPLEMENTACAO/02-FASE-1-APP-FUNCIONAL.md.

# --- Supabase (Sprint 1.1/1.2) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# --- App (Sprint 1.2) ---
# Origem pública canônica (sem barra no fim). Usada no redirectTo de reset de
# senha e OAuth — sem ela o link do e-mail vira caminho relativo e quebra.
NEXT_PUBLIC_SITE_URL=
